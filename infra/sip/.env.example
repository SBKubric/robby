# Copy to .env (never commit .env) and fill in. See README.md.

# Public SIP domain: DNS A record must point to this VPS.
SIP_DOMAIN=sip.sbkubric.com

# Let's Encrypt: account e-mail (expiry notices). LE_STAGING=1 issues a test
# certificate first (not trusted by phones), handy for a dry run.
LE_EMAIL=change-me@example.com
LE_STAGING=0
# Runs the certbot service together with Flexisip. Remove for local runs
# (Flexisip then uses a self-signed certificate).
COMPOSE_PROFILES=letsencrypt

# The two SIP accounts. At least 16 characters; generate with
#   openssl rand -base64 24
ROBBY_PASSWORD=change-me-robby-password
OFFICE_PASSWORD=change-me-office-password

# Media relay UDP ports (open them in the firewall). 200 ports = plenty for
# the 4 concurrent calls allowed in flexisip.conf.template.
RTP_PORT_MIN=40000
RTP_PORT_MAX=40199

# 1 = also listen on plain SIP/TCP 5060 (diagnostics only, keep 0).
SIP_TCP_DIAG=0

# debug | message | warning | error
FLEXISIP_LOG_LEVEL=message
